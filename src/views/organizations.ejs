<%- include('partials/header') %>
        <main id="main-content" tabindex="-1" class="listing-page">
                <header class="page-heading">
                        <div>
                <p class="section-kicker">Our community partners</p>
                <h1>
                        <%= title %>
                </h1>
                <p>Meet the organizations making a difference in our communities.</p>
                        </div>
                        <% if (user && user.role_name==='admin' ) { %>
                <a href="/new-organization" class="btn btn-primary">Add organization</a>
                        <% } %>
                </header>
                <ul class="card-grid">
                        <% organizations.forEach(org=> { %>
                                <li class="card">
                                        <img src="/images/<%= org.logo_filename %>" alt="<%= org.name %> logo">
                                        <h3>
                                                <a href="/organization/<%= org.organization_id %>">
                                                        <%= org.name %>
                                                </a>
                                        </h3>
                                        <p class="card-contact">
                                                <%= org.contact_email %>
                                        </p>
                                </li>
                                <% }) %>
                </ul>

        </main>
        <%- include('partials/footer') %>