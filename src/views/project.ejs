<%- include('partials/header') %>
    <main id="main-content" tabindex="-1" class="project-detail-page">
        <article class="project-detail-card">
            <header class="project-detail-header">
                <span class="organization-badge">Service opportunity</span>
                <h1><%= project.title %></h1>
                <p>Hosted by <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
            </header>

            <section class="project-detail-description">
                <h2>About this project</h2>
                <p><%= project.description %></p>
            </section>

            <dl class="project-detail-meta">
                <div>
                    <dt>Date</dt>
                    <dd><%= new Date(project.date).toLocaleDateString('en-US', { month: 'long' , day: 'numeric' , year: 'numeric' , timeZone: 'UTC' }) %></dd>
                </div>
                <div>
                    <dt>Location</dt>
                    <dd><%= project.location %></dd>
                </div>
                <div>
                    <dt>Organization</dt>
                    <dd><a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></dd>
                </div>
            </dl>

            <% if (categories && categories.length) { %>
                <section class="project-detail-categories">
                    <h2>Categories</h2>
                    <ul class="tag-list">
                        <% categories.forEach(category => { %>
                            <li><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
                        <% }) %>
                    </ul>
                </section>
            <% } %>

            <% if (isLoggedIn) { %>
                <section class="project-volunteer-actions" aria-label="Volunteer signup">
                    <% if (isVolunteer) { %>
                        <p>You are volunteering for this project.</p>
                        <form method="post" action="/project/<%= project.project_id %>/unvolunteer">
                            <button class="btn btn-secondary" type="submit">Remove me as a volunteer</button>
                        </form>
                    <% } else { %>
                        <form method="post" action="/project/<%= project.project_id %>/volunteer">
                            <button class="btn btn-primary" type="submit">Volunteer for this project</button>
                        </form>
                    <% } %>
                </section>
            <% } %>

            <% if (user && user.role_name==='admin' ) { %>
                <div class="project-detail-actions">
                    <a class="btn btn-secondary" href="/assign-categories/<%= project.project_id %>">Edit categories</a>
                    <a class="btn btn-primary" href="/edit-project/<%= project.project_id %>">Edit project</a>
                </div>
            <% } %>
        </article>
    </main>
    <%- include('partials/footer') %>