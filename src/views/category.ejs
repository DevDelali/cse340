<%- include('partials/header') %>
    <main id="main-content" tabindex="-1" class="listing-page">
        <header class="page-heading">
            <div>
                <p class="section-kicker">Service category</p>
                <h1><%= category.name %></h1>
                <p>Projects connected to this cause and community.</p>
            </div>
            <% if (user && user.role_name==='admin' ) { %>
                <a class="btn btn-secondary" href="/edit-category/<%= category.category_id %>">Edit category</a>
            <% } %>
        </header>

        <% if (projects.length) { %>
            <ul class="project-list">
                <% projects.forEach(project=> { %>
                    <li>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                        <p>
                            <%= project.location %>
                        </p>
                    </li>
                    <% }) %>
            </ul>
            <% } else { %>
                <p>No service projects are available for this category.</p>
                <% } %>

    </main>
    <%- include('partials/footer') %>