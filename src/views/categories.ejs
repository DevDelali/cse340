<%- include('partials/header') %>
    <main id="main-content" tabindex="-1">
        <h1>
            <%= title %>
        </h1>
        <ul class="card-grid categories">
            <% categories.forEach(function(category) { %>
                <li class="card">
                    <a href="/category/<%= category.category_id %>">
                        <%= category.name %>
                    </a>
                </li>
                <% }); %>
        </ul>
    </main>
    <%- include('partials/footer') %>