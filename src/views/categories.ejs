<%- include('partials/header') %>
    <main id="main-content" tabindex="-1" class="listing-page">
        <header class="page-heading">
            <div>
                <p class="section-kicker">Browse by interest</p>
                <h1><%= title %></h1>
                <p>Explore service opportunities by the causes and communities they support.</p>
            </div>
            <% if (user && user.role_name==='admin' ) { %>
                <a class="btn btn-primary" href="/new-category">Create category</a>
            <% } %>
        </header>
        <ul class="card-grid categories">
                    <% categories.forEach(category=> { %>
                        <li class="card category-card">
                            <a class="category-card__name" href="/category/<%= category.category_id %>">
                                <%= category.name %>
                            </a>
                        </li>
                        <% }); %>
                </ul>
    </main>
    <%- include('partials/footer') %>