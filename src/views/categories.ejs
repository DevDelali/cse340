<%- include('partials/header') %>
    <main id="main-content" tabindex="-1">
        <h1>
            <%= title %>
        </h1>

        <% if (user && user.role_name==='admin' ) { %>
            <p>
                <a class="btn btn-primary" href="/new-category">Create Category</a>
            </p>
            <% } %>

                <ul class="card-grid categories">
                    <% categories.forEach(category=> { %>
                        <li class="card category-card">
                            <a class="category-card__name" href="/category/<%= category.category_id %>">
                                <%= category.name %>
                            </a>
                        </li>
                        <% }); %>
                </ul>
    </main>
    <%- include('partials/footer') %>