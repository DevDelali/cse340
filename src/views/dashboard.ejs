<%- include('partials/header') %>

<main class="dashboard-page" id="main-content" tabindex="-1">
    <section class="dashboard-shell">
        <header class="dashboard-header">
            <div>
                <p class="section-kicker">Welcome back</p>
                <h1><%= title %></h1>
            </div>
            <div class="dashboard-role-badge">
                <span>Role</span>
                <strong><%= user && user.role_name ? user.role_name : 'member' %></strong>
            </div>
        </header>

        <section class="dashboard-overview">
            <div class="profile-card">
                <div class="profile-card__icon" aria-hidden="true">👤</div>
                <div>
                    <p class="profile-label">Account</p>
                    <h2><%= name %></h2>
                    <p><%= email %></p>
                </div>
            </div>

            <div class="stats-grid">
                <article class="stat-card stat-card--primary">
                    <span class="stat-card__label">Access Level</span>
                    <strong><%= user && user.role_name === 'admin' ? 'Administrator' : 'Standard User' %></strong>
                </article>
                <article class="stat-card">
                    <span class="stat-card__label">Status</span>
                    <strong>Active</strong>
                </article>
            </div>
        </section>

        <section class="dashboard-actions" aria-label="Dashboard actions">
            <h2>Quick Actions</h2>
            <div class="action-grid">
                <a href="/organizations" class="action-card">
                    <span class="action-card__icon">🏢</span>
                    <span>
                        <strong>Organizations</strong>
                        <small>View partner organizations</small>
                    </span>
                </a>

                <a href="/projects" class="action-card">
                    <span class="action-card__icon">📁</span>
                    <span>
                        <strong>Projects</strong>
                        <small>Explore service opportunities</small>
                    </span>
                </a>

                <% if (user && user.role_name === 'admin') { %>
                    <a href="/users" class="action-card action-card--highlight">
                        <span class="action-card__icon">👥</span>
                        <span>
                            <strong>Manage Users</strong>
                            <small>View all registered accounts</small>
                        </span>
                    </a>
                <% } %>
            </div>
        </section>

        <section class="dashboard-volunteer-projects" aria-labelledby="volunteer-projects-heading">
            <h2 id="volunteer-projects-heading">Projects I'm Volunteering For</h2>
            <% if (volunteerProjects.length) { %>
                <ul>
                    <% volunteerProjects.forEach(project => { %>
                        <li>
                            <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                            <span> — <%= project.organization_name %>, <%= new Date(project.project_date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) %></span>
                            <form method="post" action="/dashboard/projects/<%= project.project_id %>/unvolunteer">
                                <button class="btn btn-secondary" type="submit">Remove me as a volunteer</button>
                            </form>
                        </li>
                    <% }) %>
                </ul>
            <% } else { %>
                <p>You have not signed up to volunteer for any projects yet.</p>
            <% } %>
        </section>
    </section>
</main>

<%- include('partials/footer') %>