<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <form action="/edit-project/<%= project.project_id %>" method="POST">
        <div class="form-group">
            <label for="title">Project Title</label>
            <input id="title" name="title" type="text" value="<%= project.title %>" maxlength="200" required />
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" maxlength="1000" required><%= project.description %></textarea>
        </div>

        <div class="form-group">
            <label for="location">Location</label>
            <input id="location" name="location" type="text" value="<%= project.location %>" maxlength="200" required />
        </div>

        <div class="form-group">
            <label for="date">Date</label>
            <input id="date" name="date" type="date" value="<%= project.date %>" required />
        </div>

        <div class="form-group">
            <label for="organizationId">Organization</label>
            <select id="organizationId" name="organizationId" required>
                <% organizations.forEach(organization => { %>
                    <option value="<%= organization.organization_id %>"
                        <%= String(organization.organization_id) === String(project.organization_id) ? 'selected' : '' %>>
                        <%= organization.name %>
                    </option>
                <% }) %>
            </select>
        </div>

        <button class="btn btn-primary" type="submit">Update Project</button>
    </form>
</main>
<%- include('partials/footer') %>