<%- include('partials/header') %>
    <main id="main-content" tabindex="-1">
        <h1>
            <%= title %>
        </h1>

        <ul class="project-list">
            <% if (projects.length) { %>
                <% projects.forEach(project=> { %>
                    <li>
                        <strong>
                            <a href="/project/<%= project.project_id %>">
                                <%= project.title %>
                            </a>
                        </strong>
                        <p>
                            Organized by:
                            <a href="/organization/<%= project.organization_id %>">
                                <%= project.organization_name %>
                            </a>
                        </p>
                        <p>
                            <%= new Date(project.date).toLocaleDateString('en-US', { month: 'long' , day: 'numeric' ,
                                year: 'numeric' , timeZone: 'UTC' }) %>
                        </p>
                        <p>
                            <%= project.location %>
                        </p>
                    </li>
                    <% }) %>
                        <% } else { %>
                            <li>No upcoming service projects are available.</li>
                            <% } %>
        </ul>
    </main>
    <%- include('partials/footer') %>