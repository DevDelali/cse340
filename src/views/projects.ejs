<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>Upcoming Service Projects</h2>
        <ul class="project-list">
            <% if (projects.length) { %>
                <% projects.forEach(project=> { %>
                    <li>
                        <strong>
                            Date: <%= new Date(project.project_date).toLocaleDateString('en-US', { month: 'long' ,
                                day: 'numeric' , year: 'numeric' , timeZone: 'UTC' }) %>:
                                <%= project.title %> (<%= project.organization_name %>)
                        </strong>
                        <p>
                            <%= project.description %>
                        </p>
                        <p>
                            <%= project.location %>
                        </p>
                    </li>
                    <% }) %>
                        <% } else { %>
                            <li>No upcoming service projects are available.</li>
                            <% } %>
        </ul>
    </main>
    <%- include('partials/footer') %>