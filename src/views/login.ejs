<%- include('partials/header') %>
    <main id="main-content" tabindex="-1" class="form-page">
        <section class="form-card">
            <p class="section-kicker">Your service network</p>
            <h1><%= title %></h1>
            <p class="form-intro">Sign in to access your account and dashboard.</p>
            <form action="/login" method="POST">
            <div class="form-group">
                <label for="email">Email (Username)</label>
                <input type="email" id="email" name="email" required />
            </div>
            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" required />
            </div>
            <button type="submit">Login</button>
            </form>
            <p class="form-footnote">New to the network? <a href="/register">Create an account</a>.</p>
        </section>
    </main>

    <%- include('partials/footer') %>