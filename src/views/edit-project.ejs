<%- include('partials/header') %>
    <main id="main-content" tabindex="-1" class="form-page">
        <section class="form-card">
            <p class="section-kicker">Project management</p>
            <h1><%= title %></h1>

            <form action="/edit-project/<%= project.project_id %>" method="POST">
            <div class="form-group">
                <label for="title">Project Title</label>
                <input type="text" id="title" name="title" value="<%= project.title %>" maxlength="200" required />
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" maxlength="1000"
                    required><%= project.description %></textarea>
            </div>

            <div class="form-group">
                <label for="location">Location</label>
                <input type="text" id="location" name="location" value="<%= project.location %>" maxlength="200"
                    required />
            </div>

            <div class="form-group">
                <label for="date">Date</label>
                <input type="date" id="date" name="date"
                    value="<%= new Date(project.date).toISOString().slice(0, 10) %>" required />
            </div>

            <div class="form-group">
                <label for="organizationId">Organization</label>
                <select id="organizationId" name="organizationId" required>
                    <% organizations.forEach(organization=> { %>
                        <option value="<%= organization.organization_id %>"
                            <%=String(organization.organization_id)===String(project.organization_id) ? 'selected' : ''
                            %>
                            >
                            <%= organization.name %>
                        </option>
                        <% }); %>
                </select>
            </div>

            <button class="btn btn-primary" type="submit">Update Project</button>
            </form>
        </section>
    </main>
    <%- include('partials/footer') %>